# ALESSIA ABAYA — production environment template.
# Copy these into your Vercel project (Settings → Environment Variables) or `vercel env add`.
# Do NOT commit real values. Everything here is required for production unless noted.

# ── Supabase (cloud project) ──────────────────────────────────
# From your Supabase project → Settings → API. These two are the whole database config:
# every query runs server-side through the service-role client, so the anon key is not used
# and no NEXT_PUBLIC_ copy of the URL is needed — Storage URLs are built from SUPABASE_URL.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SERVICE_ROLE_KEY"      # secret — server only, bypasses RLS

# ── Auth (NextAuth v5) ────────────────────────────────────────
AUTH_SECRET="GENERATE_WITH: openssl rand -hex 32"
# AUTH_TRUST_HOST / NEXTAUTH_URL are not set in production: lib/auth.ts hardcodes
# trustHost, and Auth.js resolves the URL from the request on Vercel.

# ── Admin panel + demo logins (seeded into the users table by `npm run seed`) ──
# Use a STRONG admin password in production, then run the seed against the cloud DB.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="Store Admin"
DEMO_EMAIL="demo@your-domain.com"
DEMO_PASSWORD="CHANGE_ME"

# ── SkipCash (Qatar payment gateway, QAR-native) ──────────────
# From the SkipCash merchant portal. Use PRODUCTION keys and set SKIPCASH_ENV=production.
SKIPCASH_ENV="production"                          # "sandbox" | "production"
SKIPCASH_CLIENT_ID="YOUR_CLIENT_ID"
SKIPCASH_KEY_ID="YOUR_KEY_ID"
SKIPCASH_KEY_SECRET="YOUR_KEY_SECRET"              # secret — HMAC signing key
SKIPCASH_WEBHOOK_KEY="YOUR_WEBHOOK_KEY"            # secret — validates webhook signatures

# ── Email (Resend) — order confirmations ─────────────────────
# The only email value that is an env var: it is the provider credential. Sender name,
# from-address and reply-to live in Admin → Content → Commerce & Payments.
RESEND_API_KEY="re_..."                            # blank → emails skipped

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://your-domain.com"     # used for return/webhook/email links
